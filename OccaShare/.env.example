# CORE CONFIG
SECRET_KEY=

# DATABASE CONFIG
DB_HOST=localhost
DB_NAME=occashare
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

# EMAIL CONFIGURATION
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=True
MAIL_SSL=False

# SOCIAL LOGIN CONFIGURATION
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# KYC CONFIG
KYC_ENCRYPTION_KEY=
# Use a private mounted volume in production (for example, a Railway volume).
# Do not point this inside app/static or another publicly served directory.
# KYC_PRIVATE_STORAGE_DIR=/data/occashare-identity
GEMINI_API_KEY=your-gemini-api-key-here

# VPS AI SERVER CONFIG
# The VPS AI Server provides DeepFace face matching and real liveness detection.
# Without this, the system uses a local MediaPipe fallback (less accurate).
#
# For LOCAL DEVELOPMENT: Run the VPS server locally then point to it:
#   cd vps_ai_server
#   pip install -r requirements.txt
#   uvicorn main:app --host 0.0.0.0 --port 8001
# Then set:
#   VPS_AI_URL=http://localhost:8001
#
# For PRODUCTION: Point to your deployed VPS server URL
#   VPS_AI_URL=https://api.occaserve.com
VPS_AI_URL=http://localhost:8001
VPS_API_KEY=

# CLOUDINARY CONFIG
# This sample intentionally contains no real credentials. Put the actual values
# in the ignored .env file locally and in Railway's environment variables.
# Cloudinary remains the storage provider for public app images such as profiles,
# menu items, services, galleries, and payment proofs. KYC IDs/selfies are private.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret


