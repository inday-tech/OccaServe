{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "watchPatterns": ["OccaShare/**"]
  },
  "deploy": {
    "releaseCommand": "cd OccaShare && python -m scripts.master_migration && python -m scripts.migrations.create_admin",
    "startCommand": "cd OccaShare && gunicorn app.main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:$PORT --timeout 600 --workers 2"
  }
}
